{
  "name": "time-visualization",
  "version": "1.3.0",
  "description": "Time Visualization for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "task-manager",
    "calendar",
    "planner",
    "day",
    "week",
    "month",
    "productivity",
    "time-management"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "esbuild": "0.17.3",
    "obsidian": "~1.13.1",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
