{
  "name": "time-visualization",
  "version": "1.4.4",
  "description": "Time Visualization for Obsidian",
  "main": "main.js",
  "scripts": {
    "styles": "node styles-build.mjs",
    "dev": "node styles-build.mjs && node esbuild.config.mjs",
    "build": "node styles-build.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "task-manager",
    "calendar",
    "planner",
    "day",
    "week",
    "month",
    "productivity",
    "time-management"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "0.17.3",
    "obsidian": "~1.13.1",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^2.1.9"
  }
}
